# Required Dataverse application credentials.
CAS_API_DATAVERSE_TENANT_ID=your-dataverse-tenant-id
CAS_API_DATAVERSE_CLIENT_ID=your-dataverse-client-id
CAS_API_DATAVERSE_CLIENT_SECRET=your-dataverse-client-secret
CAS_API_DATAVERSE_URL=https://your-org.crm.dynamics.com

# Required SharePoint application credentials.
CAS_API_SHAREPOINT_TENANT_ID=your-sharepoint-tenant-id
CAS_API_SHAREPOINT_CLIENT_ID=your-sharepoint-client-id
CAS_API_SHAREPOINT_CLIENT_SECRET=your-sharepoint-client-secret
CAS_API_SHAREPOINT_HOSTNAME=your-tenant.sharepoint.com
CAS_API_SHAREPOINT_SITE_PATH=/sites/your-site
CAS_API_SHAREPOINT_BASE_FOLDER=CAS Drive/OPTIMA/Plataforma Documentos

# Local API runtime.
CAS_API_HOST=127.0.0.1
CAS_API_PORT=8081
CAS_API_TIMING=1

# Student password reset and email delivery.
# Generate a long random value (at least 24 characters) and keep it server-side.
CAS_API_PASSWORD_RESET_SECRET=replace-with-a-long-random-value
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=CAS Document Portal <noreply@updates.yourdomain.com>
CAS_PORTAL_URL=https://portal.yourdomain.com
